# Copy to .env on each MacBook, then run:
# ./scripts/generate-local-config.sh

VITALSCORE_DEVELOPMENT_TEAM=YOUR_TEAM_ID
VITALSCORE_BUNDLE_IDENTIFIER=com.yourname.vitalscore
VITALSCORE_TEST_BUNDLE_IDENTIFIER=com.yourname.vitalscore.tests
VITALSCORE_CODE_SIGN_STYLE=Automatic
VITALSCORE_CODE_SIGN_IDENTITY=Apple Development
VITALSCORE_PROVISIONING_PROFILE_SPECIFIER=

VITALSCORE_API_BASE_URL=https://api.example.com
VITALSCORE_PRIVACY_POLICY_URL=https://example.com/privacy
VITALSCORE_TERMS_URL=https://example.com/terms

# Keep provider keys in .env or backend secrets only. Do not compile them into the iOS app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
VITALSCORE_AI_PROVIDER=openai
VITALSCORE_AI_DIALOG_MODEL=gpt-5.4-mini
VITALSCORE_AI_AUDIO_ANALYSIS_MODEL=gpt-audio-1.5
VITALSCORE_AI_DIALOG_HOST=127.0.0.1
VITALSCORE_AI_DIALOG_PORT=8787
VITALSCORE_AI_DIALOG_ENDPOINT=http://127.0.0.1:8787/ai/voice-conversation
# Optional: set an exact iOS speech voice identifier or a voice name substring such as Ava or Samantha.
VITALSCORE_AI_VOICE_IDENTIFIER=
